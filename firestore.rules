rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Public profile directory (used to find people for chat & split bill)
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isUser(uid);

      // Private data: transactions, reports. Only the owner can touch it.
      match /{document=**} {
        allow read, write: if isUser(uid);
      }

      // Notifications are written by whoever triggers them (like, comment, chat message).
      // The owner reads/marks them via the rule above; others may only write as themselves,
      // unread, and only for a post the owner wrote or a chat both of them are in.
      match /notifications/{nid} {
        function post(id) {
          return get(/databases/$(database)/documents/posts/$(id)).data;
        }
        function chatMembers(id) {
          return get(/databases/$(database)/documents/chats/$(id)).data.members;
        }
        function validNotification() {
          let n = request.resource.data;
          return signedIn() && uid != request.auth.uid
            && n.actorId == request.auth.uid
            && n.read == false
            && n.text is string && n.text.size() <= 200
            && (
              (n.type == 'like' && nid == 'like_' + n.postId + '_' + request.auth.uid && post(n.postId).authorId == uid) ||
              (n.type == 'comment' && nid.matches('comment_.+') && post(n.postId).authorId == uid) ||
              (n.type == 'message' && nid == 'chat_' + n.chatId
                && request.auth.uid in chatMembers(n.chatId) && uid in chatMembers(n.chatId))
            );
        }
        allow create, update: if validNotification();
        allow delete: if signedIn() && resource.data.actorId == request.auth.uid;
      }
    }

    // ---- Squads: groups that see each other's *shared* transactions.
    // Membership changes are tightly scoped: the owner manages the squad; anyone may add exactly
    // themselves with a valid, unexpired invite; a member may remove exactly themselves.
    function squad(id) {
      return get(/databases/$(database)/documents/squads/$(id)).data;
    }
    function isSquadMember(id) {
      return signedIn() && request.auth.uid in squad(id).memberUids;
    }

    match /squads/{squadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update: if signedIn() && (ownerEdit() || joining() || leaving());
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      function onlyOwnMemberEntry() {
        return request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
      }
      function ownerEdit() {
        return resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in request.resource.data.memberUids;
      }
      function joining() {
        let before = resource.data.memberUids;
        let after = request.resource.data.memberUids;
        let invite = get(/databases/$(database)/documents/squadInvites/$(request.resource.data.joinCode)).data;
        return !(request.auth.uid in before)
          && after.size() == before.size() + 1
          && after.toSet() == before.toSet().union([request.auth.uid].toSet())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'joinCode'])
          && onlyOwnMemberEntry()
          && invite.squadId == squadId && invite.expiresAt > request.time;
      }
      function leaving() {
        return request.auth.uid in resource.data.memberUids
          && request.auth.uid != resource.data.ownerId
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
          && onlyOwnMemberEntry();
      }

      // Read model of shared transactions, written by each transaction's owner in the same batch as
      // the transaction itself. Members read; only the owner writes; the squad owner may clean up.
      match /entries/{entryId} {
        allow read: if isSquadMember(squadId);
        allow create, update: if isSquadMember(squadId)
          && request.resource.data.ownerUid == request.auth.uid
          && (resource == null || resource.data.ownerUid == request.auth.uid)
          && request.resource.data.txId == entryId
          && request.resource.data.amount is number;
        allow delete: if signedIn() && (resource == null
          || resource.data.ownerUid == request.auth.uid
          || squad(squadId).ownerId == request.auth.uid);
      }
    }

    // Invite codes: unguessable ids, readable by code only (no listing), managed by the squad owner.
    match /squadInvites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/squads/$(request.resource.data.squadId)).data.ownerId == request.auth.uid;
      allow delete: if signedIn() && (resource == null || squad(resource.data.squadId).ownerId == request.auth.uid);
    }

    // ---- Split bills: visible to every linked member, managed by owner.
    match /splitBills/{billId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      // Owner can change anything; other members may only update participants (mark paid).
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']))
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---- Chat rooms & messages
    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      match /messages/{messageId} {
        function isMember() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ---- Social feed
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update: if signedIn() && (
        // author edits
        resource.data.authorId == request.auth.uid ||
        // anyone toggles only their own like
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount'])
          && request.resource.data.likes.toSet().difference(resource.data.likes.toSet())
               .union(resource.data.likes.toSet().difference(request.resource.data.likes.toSet()))
               .hasOnly([request.auth.uid])) ||
        // comment counter maintained alongside comment writes
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']))
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
